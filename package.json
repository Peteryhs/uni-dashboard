{
  "name": "uni-dashboard",
  "version": "0.1.0",
  "description": "Live dashboard for Waterloo student life",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "sources": "node apps/relay/src/cli.mjs sources",
    "poll": "node apps/relay/src/cli.mjs poll",
    "bundle": "node apps/relay/src/cli.mjs bundle",
    "health": "node apps/relay/src/cli.mjs health",
    "inspect": "node tools/inspect-db.mjs",
    "access:oauth": "node tools/configure-access-oauth.mjs",
    "serve": "node apps/relay/src/cli.mjs serve",
    "mcp": "node apps/relay/src/cli.mjs mcp",
    "mcp:token": "node apps/relay/src/cli.mjs mcp-token",
    "fixtures": "node tools/fetch-fixtures.mjs",
    "bench": "node tools/menu-parse-bench.mjs fixtures/food-$(date +%F).html 500",
    "web:install": "npm --prefix apps/web install",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "dash": "npm run web:build && npm run serve",
    "worker:dev": "npm run web:build && wrangler dev --var ACCESS_DISABLED:1",
    "worker:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "d1:create": "wrangler d1 create uni-dashboard",
    "deploy": "npm run web:build && wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Peteryhs/uni-dashboard.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Peteryhs/uni-dashboard/issues"
  },
  "homepage": "https://github.com/Peteryhs/uni-dashboard#readme",
  "type": "module",
  "dependencies": {
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^2.2.0",
    "zod": "^4.6.5"
  },
  "imports": {
    "#contract/*": "./packages/contract/src/*",
    "#sources/*": "./sources/*"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "wrangler": "^4.136.1"
  }
}
