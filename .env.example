# ==============================================================================
# Uni Dashboard Environment Secrets Configuration
# ==============================================================================
#
# IMPORTANT SECURITY RULES:
# 1. This file (.env.example) is committed to git as a documentation template.
# 2. NEVER commit your actual `.env` file containing secrets to version control.
# 3. All secrets are read ONLY by the backend relay server (Node.js / Cloudflare Worker).
# 4. NEVER prefix backend secret keys with `VITE_`! Vite automatically bundles any
#    variable starting with `VITE_` into the browser bundle, exposing it publicly.
#
# ==============================================================================

# 1. Schedule & Timetable Feed (iCalendar subscription URL)
# Obtain from Google Calendar (Secret address in iCal format) or UW Portal.
PORTAL_ICS_URL="https://calendar.google.com/calendar/ical/.../basic.ics"
GOOGLE_CALENDAR_ICS_URL="https://calendar.google.com/calendar/ical/.../basic.ics"

# 2. Waterloo LEARN Deadlines Feed (iCalendar subscription URL)
# Obtain from learn.uwaterloo.ca -> Calendar -> Settings -> Enable Calendar Feeds.
LEARN_ICS_URL="https://learn.uwaterloo.ca/d2l/le/calendar/feed/user/feed.ics?token=..."

# Automatic local polling is off by default so a deployed Worker and a laptop relay cannot both
# fetch the same Google Calendar URL. Set to 1 only when this machine is the canonical poller.
RELAY_POLL_ENABLED=0

# 3. Upcoming Gen AI Key (Google Gemini, Anthropic, or OpenAI)
# Kept securely on the backend server. The frontend client accesses AI features
# through the relay proxy endpoints (e.g. POST /v1/ai/...) and NEVER sees this key.
GEMINI_API_KEY=""
# OPENAI_API_KEY=""
