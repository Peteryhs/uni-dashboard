# Copy to .env for the local Node relay. This template contains no credentials.
# Never commit .env or private feed URLs. Never prefix backend secrets with VITE_.

# Private ICS subscriptions; leave unused feeds empty. Settings -> Connections can save these.
# Portal may use the Google schedule URL as its fallback; a shared Google URL is fetched once.
PORTAL_ICS_URL=""
GOOGLE_CALENDAR_ICS_URL=""
LEARN_ICS_URL=""

# Keep off if a deployed Worker is already polling these feeds.
# Set to 1 only when this local relay is the sole automatic poller.
RELAY_POLL_ENABLED=0

# Optional local database path and runtime connection token.
# Non-loopback binding requires RELAY_TOKEN. Never put it in a Vite build variable.
RELAY_DB="relay.db"
RELAY_TOKEN=""

# Optional: local Node access to Cloudflare Workers AI through its REST API.
# A deployed Worker uses the AI binding instead and does not need these for inference.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Worker-local development uses .dev.vars (ignored by Git), not this .env file.
# Production Access settings and your D1 ID belong in your own wrangler.toml;
# production feed URLs may be Worker secrets or authenticated app settings.
