<?xml version="1.0" encoding="utf-8"?>
<!-- Credentials are encrypted with a Keystore key that never leaves the device, so a backup
     would restore ciphertext nothing can decrypt. Exclude everything instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
