<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: plain http to the development machine as the emulator sees it. Release builds
     have no network security config, so cleartext stays off everywhere. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
