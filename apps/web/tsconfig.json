{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  /**
   * Duplicated from tsconfig.app.json on purpose. The shadcn CLI reads path aliases from this
   * file, not from the referenced project configs. Without it, `shadcn add` cannot resolve
   * "@/lib/utils", falls back to treating `cn` as a bare specifier, and installs an unrelated
   * npm package called "cn". That actually happened here.
   */
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "#contract/*": ["../../packages/contract/src/*"]
    }
  }
}
